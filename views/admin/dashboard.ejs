<%- include("../partials/header") %><div class="d-flex justify-content-between align-items-center mb-4"><div><span class="eyebrow">OVERVIEW</span><h1 class="section-title mb-0">Admin dashboard</h1></div><% if (currentUser.role !== "doctor") { %><a class="btn btn-primary" href="/camps/new"><i class="bi bi-plus-lg me-1"></i> Create camp</a><% } %></div>
<div class="row g-3 mb-4"><% const cards=[["Students",stats.students,"bi-people"],["Medical camps",stats.camps,"bi-hospital"],["Upcoming camps",stats.upcoming,"bi-calendar-event"],["Appointments",stats.appointments,"bi-calendar-check"],["Completed",stats.completed,"bi-check-circle"],["Pending",stats.pending,"bi-hourglass"],["Health records",stats.records,"bi-clipboard2-pulse"]]; cards.forEach(c=>{ %><div class="col-6 col-lg-3"><div class="stat-card"><div class="d-flex justify-content-between"><span><%= c[0] %></span><i class="bi <%= c[2] %>"></i></div><div class="stat-number"><%= c[1] %></div></div></div><% }) %></div>
<div class="row g-4"><div class="col-lg-6"><div class="card border-0 shadow-sm"><div class="card-body"><h5>Recent registrations</h5><div class="table-responsive"><table class="table"><thead><tr><th>Student</th><th>ID</th><th>Department</th></tr></thead><tbody><% recentStudents.forEach(s=>{ %><tr><td><%= s.fullName %></td><td><%= s.studentId %></td><td><%= s.department %></td></tr><% }) %></tbody></table></div></div></div></div>
<div class="col-lg-6"><div class="card border-0 shadow-sm"><div class="card-body"><h5>Recent appointments</h5><div class="table-responsive"><table class="table"><thead><tr><th>Student</th><th>Camp</th><th>Status</th></tr></thead><tbody><% recentAppointments.forEach(a=>{ %><tr><td><%= a.student?.fullName || "—" %></td><td><%= a.camp?.name || "—" %></td><td><span class="badge text-bg-secondary"><%= a.status %></span></td></tr><% }) %></tbody></table></div></div></div></div></div>
<div class="row g-4 mt-1">
<div class="col-lg-6"><div class="card border-0 shadow-sm h-100"><div class="card-body"><h5>Appointment status overview</h5><canvas id="appointmentChart" height="210"></canvas><% if (!appointmentStatus.length) { %><p class="text-muted small mb-0">No appointment data yet.</p><% } %></div></div></div>
<div class="col-lg-6"><div class="card border-0 shadow-sm h-100"><div class="card-body"><h5>Quick actions</h5><div class="d-grid gap-2"><a class="btn btn-outline-primary" href="/records">Manage health records</a><% if (currentUser.role === "admin" || currentUser.role === "staff") { %><a class="btn btn-outline-primary" href="/admin/students">Manage students</a><a class="btn btn-outline-primary" href="/camps">Manage medical camps</a><% } %><% if (currentUser.role === "admin") { %><a class="btn btn-outline-primary" href="/admin/doctors">Manage doctor accounts</a><% } %></div></div></div></div>
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
(() => {
 const canvas = document.getElementById("appointmentChart");
 if (!canvas || !window.Chart) return;
 const rows = <%- JSON.stringify(appointmentStatus.map(x => ({ label: x._id, count: x.count }))) %>;
 if (!rows.length) return;
 new Chart(canvas, { type: "doughnut", data: { labels: rows.map(x => x.label), datasets: [{ data: rows.map(x => x.count) }] }, options: { responsive: true, plugins: { legend: { position: "bottom" } } } });
})();
</script>
<div class="row g-4 mt-1"><div class="col-lg-7"><div class="premium-panel p-4 h-100"><h5>Appointment activity · Last 6 months</h5><canvas id="monthlyChart" height="120"></canvas></div></div><div class="col-lg-5"><div class="premium-panel p-4 h-100"><h5>Low-stock watchlist</h5><% if (lowStockItems && lowStockItems.length) { lowStockItems.forEach(item => { %><div class="d-flex justify-content-between align-items-center border-bottom py-2"><div><strong><%= item.name %></strong><div class="small text-muted">Reorder level: <%= item.reorderLevel %></div></div><span class="badge text-bg-warning"><%= item.quantity %> <%= item.unit %></span></div><% }) } else { %><p class="text-muted mb-0">No low-stock items.</p><% } %><a class="btn btn-sm btn-outline-primary mt-3" href="/inventory">Open inventory</a></div></div></div>
<script>
(() => { const el=document.getElementById("monthlyChart"); if(!el || !window.Chart) return; const rows=<%- JSON.stringify(monthlyAppointments.map(x=>({label:`${x._id.month}/${x._id.year}`,count:x.count}))) %>; new Chart(el,{type:"bar",data:{labels:rows.map(x=>x.label),datasets:[{label:"Appointments",data:rows.map(x=>x.count),borderRadius:8}]},options:{responsive:true,plugins:{legend:{display:false}},scales:{y:{beginAtZero:true,ticks:{precision:0}}}}}); })();
</script>
<div class="card border-0 shadow-sm mt-4"><div class="card-body"><h5>Latest notifications</h5><% notifications.forEach(n=>{ %><div class="border-bottom py-2"><strong><%= n.title %></strong><p class="mb-0 text-muted"><%= n.message %></p></div><% }) %><% if(!notifications.length){ %><p class="text-muted">No notifications yet.</p><% } %></div></div><%- include("../partials/footer") %>
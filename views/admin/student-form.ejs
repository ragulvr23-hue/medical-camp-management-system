<%- include("../partials/header") %><h1 class="section-title"><%= title %></h1><form method="post" action="<%= student ? '/admin/students/'+student._id : '/admin/students' %>" class="card border-0 shadow-sm p-4"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="row g-3">
<% const fields=[["studentId","Student ID"],["fullName","Full name"],["age","Age"],["gender","Gender"],["department","Department"],["className","Class / Year"],["contact","Contact"],["email","Email"],["guardianName","Guardian name"],["guardianContact","Guardian contact"],["address","Address"]]; fields.forEach(f=>{ %><div class="col-md-6"><label class="form-label"><%= f[1] %></label><% if(f[0]==="gender"){ %><select class="form-select" name="gender" required><% ["Female","Male","Other"].forEach(g=>{ %><option <%= student?.gender===g?"selected":"" %>><%= g %></option><% }) %></select><% } else if(f[0]==="address"){ %><textarea class="form-control" name="address"><%= student?.address||"" %></textarea><% } else { %><input class="form-control" name="<%= f[0] %>" value="<%= student?.[f[0]]||"" %>" <%= ["studentId","fullName","age","department","contact","email","guardianName","guardianContact","address"].includes(f[0])?"required":"" %>><% } %></div><% }) %>
<% if(!student){ %><div class="col-md-6"><label class="form-label">Optional student login password</label><input class="form-control" type="password" name="password" minlength="8"></div><% } %></div><button class="btn btn-primary mt-4">Save student</button></form><%- include("../partials/footer") %>
<%- include("../partials/header") %><div class="d-flex justify-content-between align-items-center mb-3"><h1 class="section-title mb-0">Students</h1><a class="btn btn-primary" href="/admin/students/new">Add student</a></div><form class="row g-2 mb-3"><div class="col-md-5"><input class="form-control" name="q" value="<%= q %>" placeholder="Search by ID, name or department"></div><div class="col-auto"><button class="btn btn-outline-primary">Search</button></div></form><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Student ID</th><th>Name</th><th>Department</th><th>Email</th><th>Actions</th></tr></thead><tbody><% students.forEach(s=>{ %><tr><td><%= s.studentId %></td><td><%= s.fullName %></td><td><%= s.department %></td><td><%= s.email %></td><td><a class="btn btn-sm btn-outline-primary" href="/admin/students/<%= s._id %>/edit">Edit</a> <form class="d-inline confirm-delete" method="post" action="/admin/students/<%= s._id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr><% }) %></tbody></table></div></div><%- include("../partials/footer") %>
<%- include("../partials/header") %><h1 class="section-title">Book an appointment</h1><form method="post" action="/appointments" class="card border-0 shadow-sm p-4"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<% if(!student){ %><div class="mb-3"><label class="form-label">Student</label><select class="form-select" name="student" required><option value="">Select student</option><% students.forEach(s=>{ %><option value="<%= s._id %>"><%= s.studentId %> — <%= s.fullName %></option><% }) %></select></div><% } else { %><p class="text-muted">Booking for <strong><%= student.fullName %></strong> (<%= student.studentId %>)</p><% } %>
<div class="mb-3"><label class="form-label">Medical camp</label><select class="form-select" name="camp" required><option value="">Select camp</option><% camps.forEach(c=>{ %><option value="<%= c._id %>"><%= c.name %> — <%= new Date(c.date).toLocaleDateString() %> — <%= c.location %></option><% }) %></select></div><div class="mb-3"><label class="form-label">Notes (optional)</label><textarea class="form-control" name="notes"></textarea></div><button class="btn btn-primary" <%= !camps.length||(!student&&!students.length)?'disabled':'' %>>Confirm booking</button></form><%- include("../partials/footer") %>
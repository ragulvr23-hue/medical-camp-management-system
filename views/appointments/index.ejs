<%- include("../partials/header") %><div class="d-flex justify-content-between align-items-center mb-3"><h1 class="section-title mb-0">Appointments</h1><a class="btn btn-primary" href="/appointments/book">Book appointment</a></div><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Student</th><th>Camp</th><th>Date</th><th>Status</th><th>Action</th></tr></thead><tbody><% appointments.forEach(a=>{ %><tr><td><%= a.student?.fullName||"—" %></td><td><%= a.camp?.name||"—" %></td><td><%= a.appointmentDate?new Date(a.appointmentDate).toLocaleDateString():"—" %></td><td><span class="badge text-bg-secondary"><%= a.status %></span></td><td><% if(["admin","staff"].includes(currentUser.role)){ %><form method="post" action="/appointments/<%= a._id %>/status" class="d-flex gap-1"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select class="form-select form-select-sm" name="status"><% ["Pending","Confirmed","Completed","Cancelled"].forEach(s=>{ %><option <%= a.status===s?"selected":"" %>><%= s %></option><% }) %></select><button class="btn btn-sm btn-outline-primary">Update</button></form><% } else if(a.status!=="Cancelled"&&a.status!=="Completed"){ %><form method="post" action="/appointments/<%= a._id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="Cancelled"><button class="btn btn-sm btn-outline-danger">Cancel</button></form><% } %></td></tr><% }) %></tbody></table></div></div><%- include("../partials/footer") %>
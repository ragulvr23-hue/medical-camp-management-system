<%- include("../partials/header") %>
<div class="page-heading"><div><span class="eyebrow">SECURITY & ACCOUNTABILITY</span><h1 class="section-title mb-1">Audit trail</h1><p class="text-muted mb-0">Recent administrative and clinical data changes.</p></div></div>
<div class="premium-panel p-3 p-md-4"><div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Date & time</th><th>User</th><th>Role</th><th>Action</th><th>Record type</th><th>Details</th></tr></thead><tbody><% logs.forEach(log=>{ %><tr><td class="text-nowrap"><%= new Date(log.createdAt).toLocaleString() %></td><td><strong><%= log.actorName %></strong><div class="small text-muted"><%= log.actor?.email || "Account unavailable" %></div></td><td><span class="badge text-bg-light"><%= log.actorRole %></span></td><td><%= log.action %></td><td><%= log.entity %></td><td><%= log.details || "—" %></td></tr><% }) %><% if(!logs.length){ %><tr><td colspan="6" class="text-center text-muted py-4">No audit events recorded yet.</td></tr><% } %></tbody></table></div><p class="small text-muted mb-0">Showing the latest 300 events. Audit entries are created when supported changes are made.</p></div>
<%- include("../partials/footer") %>

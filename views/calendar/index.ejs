<%- include("../partials/header") %>
<div class="page-heading"><div><span class="eyebrow">PLANNING & SCHEDULING</span><h1 class="section-title mb-1">Medical camp calendar</h1><p class="text-muted mb-0">Upcoming and scheduled medical camps.</p></div><% if(['admin','staff'].includes(currentUser.role)){ %><a class="btn btn-primary" href="/camps/new"><i class="bi bi-plus-lg me-1"></i> Schedule camp</a><% } %></div>
<div class="premium-panel p-3 p-md-4"><div class="row g-3"><% camps.forEach(camp=>{ %><div class="col-md-6 col-xl-4"><div class="calendar-event h-100"><div class="d-flex justify-content-between align-items-start"><span class="calendar-date"><strong><%= new Date(camp.date).toLocaleDateString(undefined,{day:'2-digit'}) %></strong><small><%= new Date(camp.date).toLocaleDateString(undefined,{month:'short',year:'numeric'}) %></small></span><span class="badge text-bg-success">Scheduled</span></div><h5 class="mt-3"><%= camp.name %></h5><p class="text-muted small mb-2"><i class="bi bi-geo-alt me-1"></i><%= camp.location %></p><p class="small mb-1"><i class="bi bi-clock me-1"></i><%= camp.startTime %> – <%= camp.endTime %></p><p class="small text-muted mb-3"><%= camp.description %></p><a class="btn btn-sm btn-outline-primary" href="/appointments/book">Book appointment</a></div></div><% }) %><% if(!camps.length){ %><div class="col-12 text-center text-muted py-5">No active camps scheduled yet.</div><% } %></div></div>
<%- include("../partials/footer") %>

<%- include("../partials/header") %><h1 class="section-title"><%= title %></h1><form method="post" action="<%= camp?'/camps/'+camp._id:'/camps' %>" class="card border-0 shadow-sm p-4"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="row g-3"><% const f=[["name","Camp name","text"],["description","Description","text"],["date","Date","date"],["startTime","Start time","time"],["endTime","End time","time"],["location","Location","text"],["staff","Doctors / staff (comma separated)","text"],["capacity","Capacity","number"]]; f.forEach(x=>{ %><div class="col-md-6"><label class="form-label"><%= x[1] %></label><input class="form-control" type="<%= x[2] %>" name="<%= x[0] %>" value="<%= x[0]==='staff'?(camp?.staff||[]).join(', '):(camp?.[x[0]]||'') %>" required></div><% }) %></div><button class="btn btn-primary mt-4">Save camp</button></form><%- include("../partials/footer") %>
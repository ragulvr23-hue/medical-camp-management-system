<%- include("../partials/header") %><div class="d-flex justify-content-between align-items-center mb-3"><h1 class="section-title mb-0">Medical camps</h1><% if(["admin","staff"].includes(currentUser.role)){ %><a class="btn btn-primary" href="/camps/new">Create camp</a><% } %></div><div class="row g-3"><% camps.forEach(c=>{ %><div class="col-md-6 col-lg-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="d-flex justify-content-between"><span class="badge <%= c.active?'text-bg-success':'text-bg-secondary' %>"><%= c.active?'Active':'Inactive' %></span><span class="small text-muted">Capacity: <%= c.capacity %></span></div><h5 class="mt-3"><%= c.name %></h5><p class="text-muted"><%= c.description %></p><p class="mb-1"><i class="bi bi-calendar me-2"></i><%= new Date(c.date).toLocaleDateString() %> · <%= c.startTime %>–<%= c.endTime %></p><p><i class="bi bi-geo-alt me-2"></i><%= c.location %></p><% if(["admin","staff"].includes(currentUser.role)){ %><a class="btn btn-sm btn-outline-primary" href="/camps/<%= c._id %>/edit">Edit</a><form class="d-inline" method="post" action="/camps/<%= c._id %>/deactivate"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-outline-danger">Deactivate</button></form><% } %><a class="btn btn-sm btn-primary float-end" href="/appointments/book">Book</a></div></div></div><% }) %><% if(!camps.length){ %><p class="text-muted">No camps available.</p><% } %></div><%- include("../partials/footer") %>
<%- include("partials/header") %>
<section class="hero p-4 p-lg-5 rounded-4 mb-4"><div class="row align-items-center"><div class="col-lg-7"><span class="eyebrow">HEALTHCARE MANAGEMENT PLATFORM</span><h1 class="display-5 fw-bold mt-3">A healthier campus starts with better care coordination.</h1><p class="lead mt-3">Manage student registration, medical camps, appointments and health information in one organized platform.</p><a class="btn btn-light btn-lg mt-2" href="/register">Student registration <i class="bi bi-arrow-right"></i></a></div><div class="col-lg-5 text-center"><i class="bi bi-hospital hero-icon"></i></div></div></section>
<div class="row g-3 mb-5"><div class="col-md-4"><div class="feature"><i class="bi bi-calendar2-check"></i><h5>Camp scheduling</h5><p>Publish medical camps and manage appointment capacity.</p></div></div><div class="col-md-4"><div class="feature"><i class="bi bi-clipboard2-pulse"></i><h5>Health records</h5><p>Keep authorized clinical staff access to student visit records.</p></div></div><div class="col-md-4"><div class="feature"><i class="bi bi-bell"></i><h5>Announcements</h5><p>Share camp updates and health awareness notices.</p></div></div></div>
<h3 class="section-title">Upcoming medical camps</h3><div class="row g-3 mb-4"><% camps.forEach(c => { %><div class="col-md-4"><div class="card h-100 shadow-sm border-0"><div class="card-body"><span class="badge text-bg-info mb-2">Upcoming</span><h5><%= c.name %></h5><p class="text-muted"><%= c.description %></p><div><i class="bi bi-calendar me-2"></i><%= new Date(c.date).toLocaleDateString() %></div><div><i class="bi bi-geo-alt me-2"></i><%= c.location %></div></div></div></div><% }) %><% if (!camps.length) { %><p class="text-muted">No upcoming camps have been published.</p><% } %></div>
<%- include("partials/footer") %>
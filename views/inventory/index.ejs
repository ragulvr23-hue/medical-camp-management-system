<%- include("../partials/header") %>
<div class="page-heading"><div><span class="eyebrow">CLINICAL OPERATIONS</span><h1 class="section-title mb-1">Medicine inventory</h1><p class="text-muted mb-0">Track stock levels, batches and expiry dates.</p></div></div>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="stat-card"><span>Inventory items</span><div class="stat-number"><%= items.length %></div></div></div><div class="col-md-4"><div class="stat-card"><span>Low-stock alerts</span><div class="stat-number text-warning"><%= lowStock %></div></div></div><div class="col-md-4"><div class="stat-card"><span>Expiring in 30 days</span><div class="stat-number text-danger"><%= expiring %></div></div></div></div>
<div class="row g-4"><div class="col-lg-4"><div class="premium-panel p-4"><h5 class="mb-3">Add inventory item</h5><form method="post" action="/inventory" class="vstack gap-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label mb-0">Item / medicine name</label><input class="form-control" name="name" required maxlength="120"><label class="form-label mb-0">Category</label><input class="form-control" name="category" placeholder="Medicine, Consumable..."><div class="row g-2"><div class="col-6"><label class="form-label mb-0">Quantity</label><input class="form-control" type="number" name="quantity" min="0" required></div><div class="col-6"><label class="form-label mb-0">Unit</label><input class="form-control" name="unit" value="units" required></div></div><div class="row g-2"><div class="col-6"><label class="form-label mb-0">Reorder level</label><input class="form-control" type="number" name="reorderLevel" min="0" value="10"></div><div class="col-6"><label class="form-label mb-0">Batch number</label><input class="form-control" name="batchNumber"></div></div><label class="form-label mb-0">Expiry date</label><input class="form-control" type="date" name="expiryDate"><label class="form-label mb-0">Notes</label><textarea class="form-control" name="notes" rows="2"></textarea><button class="btn btn-primary mt-2">Save inventory item</button></form></div></div>
<div class="col-lg-8"><div class="premium-panel p-3 p-md-4"><form class="d-flex gap-2 mb-3"><input class="form-control" name="q" value="<%= q %>" placeholder="Search name, category or batch"><button class="btn btn-outline-primary">Search</button><a class="btn btn-outline-secondary" href="/inventory">Clear</a></form><div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Item</th><th>Stock</th><th>Expiry</th><th>Stock adjustment</th></tr></thead><tbody><% items.forEach(item => { const isLow = item.quantity <= item.reorderLevel; const isExpired = item.expiryDate && new Date(item.expiryDate) < new Date(); %><tr><td><strong><%= item.name %></strong><div class="small text-muted"><%= item.category %> · Batch <%= item.batchNumber || "—" %></div></td><td><span class="badge <%= isLow ? 'text-bg-warning' : 'text-bg-success' %>"><%= item.quantity %> <%= item.unit %></span><div class="small text-muted">Reorder at <%= item.reorderLevel %></div></td><td><% if(item.expiryDate){ %><span class="<%= isExpired ? 'text-danger fw-bold' : '' %>"><%= new Date(item.expiryDate).toLocaleDateString() %></span><% } else { %>—<% } %></td><td><form method="post" action="/inventory/<%= item._id %>/stock" class="d-flex gap-1"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="form-control form-control-sm" style="max-width:90px" type="number" name="change" placeholder="+/-" required><button class="btn btn-sm btn-outline-primary">Update</button></form></td></tr><% }) %><% if(!items.length){ %><tr><td colspan="4" class="text-center text-muted py-4">No inventory items found.</td></tr><% } %></tbody></table></div></div></div></div>
<p class="small text-muted mt-3">Inventory is an academic stock-tracking module. Verify medicine identity, batch and expiry before clinical use.</p>
<%- include("../partials/footer") %>

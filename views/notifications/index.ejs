<%- include("../partials/header") %><h1 class="section-title">Notifications & announcements</h1><% if(["admin","staff"].includes(currentUser.role)){ %><form method="post" action="/notifications" class="card border-0 shadow-sm p-4 mb-4"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h5>Publish announcement</h5><div class="row g-3"><div class="col-md-4"><label class="form-label">Title</label><input class="form-control" name="title" required></div><div class="col-md-4"><label class="form-label">Target</label><select class="form-select" name="target"><option>All</option><option>Department</option></select></div><div class="col-md-4"><label class="form-label">Department (if targeted)</label><input class="form-control" name="department"></div><div class="col-12"><label class="form-label">Message</label><textarea class="form-control" name="message" required></textarea></div></div><button class="btn btn-primary mt-3">Publish</button></form><% } %><div class="row g-3"><% notifications.forEach(n=>{ %><div class="col-md-6"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="d-flex justify-content-between"><h5><%= n.title %></h5><span class="badge text-bg-info"><%= n.target %></span></div><p><%= n.message %></p><small class="text-muted"><%= new Date(n.publishAt).toLocaleString() %></small></div></div></div><% }) %><% if(!notifications.length){ %><p class="text-muted">No notifications published.</p><% } %></div><%- include("../partials/footer") %>
<%- include("../partials/header") %><h1 class="section-title">Add health record</h1><form method="post" action="/records" class="card border-0 shadow-sm p-4"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="row g-3"><div class="col-md-6"><label class="form-label">Student</label><select class="form-select" name="student" required><option value="">Select student</option><% students.forEach(s=>{ %><option value="<%= s._id %>"><%= s.studentId %> — <%= s.fullName %></option><% }) %></select></div><div class="col-md-6"><label class="form-label">Visit date</label><input class="form-control" type="date" name="visitDate"></div><div class="col-md-4"><label class="form-label">Blood group</label><select class="form-select" name="bloodGroup"><% ["Unknown","A+","A-","B+","B-","AB+","AB-","O+","O-"].forEach(b=>{ %><option><%= b %></option><% }) %></select></div><div class="col-md-4"><label class="form-label">Blood pressure</label><input class="form-control" name="bloodPressure" placeholder="e.g. 120/80"></div><div class="col-md-4"><label class="form-label">Temperature (°C)</label><input class="form-control" name="temperature" type="number" step="0.1"></div><div class="col-md-4"><label class="form-label">Height (cm)</label><input class="form-control" name="heightCm" type="number" step="0.1"></div><div class="col-md-4"><label class="form-label">Weight (kg)</label><input class="form-control" name="weightKg" type="number" step="0.1"></div><div class="col-md-4"><label class="form-label">Doctor / medical officer</label><input class="form-control" name="doctor" required></div><% [["medicalHistory","Medical history"],["allergies","Known allergies"],["symptoms","Symptoms"],["diagnosis","Diagnosis / assessment"],["treatment","Treatment"],["advice","Medical advice"]].forEach(f=>{ %><div class="col-md-6"><label class="form-label"><%= f[1] %></label><textarea class="form-control" name="<%= f[0] %>" <%= ["symptoms","diagnosis"].includes(f[0])?"required":"" %>></textarea></div><% }) %></div><button class="btn btn-primary mt-4">Save confidential record</button></form><%- include("../partials/footer") %>
<%- include("../partials/header") %><span class="eyebrow">STUDENT PORTAL</span><h1 class="section-title">Welcome, <%= student?.fullName||currentUser.name %></h1><div class="row g-3 mb-4"><div class="col-md-4"><div class="stat-card"><span>Student ID</span><div class="stat-number fs-3"><%= student?.studentId||"—" %></div></div></div><div class="col-md-4"><div class="stat-card"><span>Department</span><div class="stat-number fs-3"><%= student?.department||"—" %></div></div></div><div class="col-md-4"><div class="stat-card"><span>Appointments</span><div class="stat-number"><%= appointments.length %></div></div></div></div><div class="d-flex gap-2 mb-4"><a class="btn btn-primary" href="/appointments/book">Book a camp</a><a class="btn btn-outline-primary" href="/appointments">My appointments</a><a class="btn btn-outline-primary" href="/student/health-card"><i class="bi bi-qr-code me-1"></i> My health card</a></div><h4>My appointments</h4><% appointments.forEach(a=>{ %><div class="card border-0 shadow-sm p-3 mb-2"><strong><%= a.camp?.name||"Camp" %></strong><span class="text-muted"><%= a.camp?.date?new Date(a.camp.date).toLocaleDateString():"" %> · <%= a.status %></span></div><% }) %><h4 class="mt-4">My Health Records</h4>
<% if (healthRecords && healthRecords.length) { %>
  <p class="text-muted small">Your medical records entered by authorized healthcare staff.</p>
  <% healthRecords.forEach(r => { %>
    <div class="card border-0 shadow-sm p-3 mb-3">
      <div class="d-flex justify-content-between flex-wrap gap-2">
        <strong>Visit: <%= r.visitDate ? new Date(r.visitDate).toLocaleDateString() : "—" %></strong>
        <span class="text-muted">Doctor: <%= r.doctor || "—" %></span>
      </div>
      <div class="row g-3 mt-1">
        <div class="col-md-4"><small class="text-muted">Blood group</small><div><%= r.bloodGroup || "—" %></div></div>
        <div class="col-md-4"><small class="text-muted">Blood pressure</small><div><%= r.bloodPressure || "—" %></div></div>
        <div class="col-md-4"><small class="text-muted">Temperature</small><div><%= r.temperature != null ? r.temperature + " °C" : "—" %></div></div>
        <div class="col-md-4"><small class="text-muted">Height</small><div><%= r.heightCm != null ? r.heightCm + " cm" : "—" %></div></div>
        <div class="col-md-4"><small class="text-muted">Weight</small><div><%= r.weightKg != null ? r.weightKg + " kg" : "—" %></div></div>
        <div class="col-md-4"><small class="text-muted">Allergies</small><div><%= r.allergies || "—" %></div></div>
        <div class="col-md-6"><small class="text-muted">Symptoms</small><div><%= r.symptoms || "—" %></div></div>
        <div class="col-md-6"><small class="text-muted">Diagnosis / Assessment</small><div><%= r.diagnosis || "—" %></div></div>
        <div class="col-md-6"><small class="text-muted">Treatment</small><div><%= r.treatment || "—" %></div></div>
        <div class="col-md-6"><small class="text-muted">Medical advice</small><div><%= r.advice || "—" %></div></div>
        <% if (r.medicalHistory) { %><div class="col-12"><small class="text-muted">Medical history</small><div><%= r.medicalHistory %></div></div><% } %>
      </div>
    </div>
  <% }) %>
<% } else { %>
  <div class="alert alert-info">No health records are available yet. Your records will appear here after the doctor or authorized healthcare staff saves them.</div>
<% } %>
<h4 class="mt-4">Announcements</h4><% notifications.forEach(n=>{ %><div class="border-bottom py-2"><strong><%= n.title %></strong><p class="mb-0 text-muted"><%= n.message %></p></div><% }) %><%- include("../partials/footer") %>
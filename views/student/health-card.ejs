<%- include("../partials/header") %>
<div class="page-heading"><div><span class="eyebrow">STUDENT IDENTITY</span><h1 class="section-title mb-1">Digital health card</h1><p class="text-muted mb-0">Your student identity card for medical camp check-in.</p></div><button class="btn btn-outline-primary" onclick="window.print()"><i class="bi bi-printer me-1"></i> Print card</button></div>
<div class="health-card-shell"><div class="health-card-top"><div><div class="small text-uppercase fw-bold opacity-75">Medical Camp & Student Health Record System</div><h2 class="text-white mt-2 mb-0">Student Health ID</h2></div><i class="bi bi-heart-pulse-fill text-white fs-1"></i></div><div class="health-card-body"><div class="health-card-avatar"><i class="bi bi-person-fill"></i></div><div class="flex-grow-1"><h3><%= student.fullName %></h3><div class="health-id"><%= student.studentId %></div><div class="row g-2 mt-2"><div class="col-6"><small>Department</small><strong><%= student.department %></strong></div><div class="col-6"><small>Class</small><strong><%= student.className || "—" %></strong></div><div class="col-6"><small>Blood group</small><strong>Available in health records</strong></div><div class="col-6"><small>Registered email</small><strong><%= student.email %></strong></div></div></div><div class="health-card-qr"><img src="<%= qrDataUrl %>" alt="QR code for authenticated health card"><small>Scan to open<br>authenticated card</small></div></div><div class="health-card-footer"><span><i class="bi bi-shield-lock me-1"></i> Private student account</span><span>Generated <%= new Date().toLocaleDateString() %></span></div></div>
<p class="small text-muted mt-3">The QR code opens the authenticated health-card page; it does not contain medical details. Keep your login credentials private.</p>
<style>@media print{nav,.footer,.page-heading button,.alert{display:none!important}body{background:#fff}.health-card-shell{box-shadow:none!important;margin:2cm auto;max-width:900px}}</style>
<%- include("../partials/footer") %>

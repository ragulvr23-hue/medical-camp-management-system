<%- include("../partials/header") %><h1 class="section-title">My profile</h1><div class="card border-0 shadow-sm"><div class="card-body p-4"><% if(student){ %><dl class="row"><% [["Student ID",student.studentId],["Name",student.fullName],["Age",student.age],["Gender",student.gender],["Department",student.department],["Contact",student.contact],["Email",student.email],["Guardian",student.guardianName],["Guardian contact",student.guardianContact],["Address",student.address]].forEach(x=>{ %><dt class="col-sm-3"><%= x[0] %></dt><dd class="col-sm-9"><%= x[1] %></dd><% }) %></dl><% } else { %><p>Signed in as <%= currentUser.name %> (<%= currentUser.role %>).</p><% } %></div></div><%- include("../partials/footer") %>